+
+/// Block user-initiated close/quit during a financial write or recognition task.
+/// Application-specific extension; the application has one desktop window.
+static CLOSE_BLOCKED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+/// Enable or disable the application close guard.
+pub fn set_close_blocked(blocked: bool) {
+    CLOSE_BLOCKED.store(blocked, std::sync::atomic::Ordering::SeqCst);
+}
+/// Whether an in-flight application operation blocks close.
+pub fn close_blocked() -> bool {
+    CLOSE_BLOCKED.load(std::sync::atomic::Ordering::SeqCst)
+}
